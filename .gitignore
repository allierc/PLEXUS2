experiments/*/mp4/
experiments/*/png/
experiments/*/data/*.png
experiments/*/data/*.mp4
experiments/*/story/

# simulation data, except the seed tables the exp09 specs read
*.npz
*.npy
!experiments/exp09_molecular_landscape/data/seed_it*.npz
!experiments/exp09_molecular_landscape/data/seed_rna*.npz

# drafts the GUI writes from a prompt
config/studio/
